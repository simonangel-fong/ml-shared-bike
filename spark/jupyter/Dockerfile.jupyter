FROM quay.io/jupyter/pyspark-notebook:spark-3.5.0

USER root
# mount point for the bind-mounted data folder; ownership is set at runtime by
# the image's start hook (CHOWN_EXTRA), since NB_UID is overridden in compose
RUN mkdir -p /opt/data
USER ${NB_UID}

COPY --chown=${NB_UID}:${NB_GID} requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

ENV PYTHONPATH=/usr/local/spark/python:/usr/local/spark/python/lib/py4j-0.10.9.7-src.zip
